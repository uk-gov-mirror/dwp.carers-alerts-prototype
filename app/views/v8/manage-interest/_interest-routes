router.post('/' + version + '/manage-interest/stop-request-clarify', function (req, res) {
    if(req.session.data['stopRequest'] == 'yes'){
        let viewableInterestsArray =  req.session.data['viewableInterests']
        let activeInterestsArray = req.session.data['activeInterests']
        let tempObject = req.session.data['selectedPerson']

        for(let x = 0; x < viewableInterestsArray.length; x++) {
            if(viewableInterestsArray[x].nino == tempObject.nino){
                viewableInterestsArray.splice(x, 1);
            }
        }
        for(let x = 0; x < activeInterestsArray.length; x++) {
            if(activeInterestsArray[x].nino == tempObject.nino){
                activeInterestsArray.splice(x, 1);
            }
        }
        req.session.data['viewableInterests'] = viewableInterestsArray 
        req.session.data['activeInterests'] = activeInterestsArray
        res.redirect("stop-request-confirmation")
    }
    else{
        res.redirect("clear-manage-sessions")
    }
})


router.get('/' + version + '/manage-interest/clear-manage-sessions', function (req, res) {
