router.post('/' + version + '/manage-interest/set-interest', function (req, res) {
   req.session.data['error'] = "false"
   let nino = req.session.data['nino'].toUpperCase().replace(/ /g,'') //converts the nino to uppercase removing any spaces
   req.session.data['nino'] = nino // writes the reformatted nino back to the session
   
   // this section uses the nino above and searches through our JSON data to see if a record matches

   let people = req.session.data['earnings'] // creates an array of the data in the JSON file for us to manipulate in this post
   req.session.data['selectedPerson'] = null // removes anything from the session if it already exists. this becomes important a few lines down

   for (let x = 0; x < people.length; x++) { // this loops through each person in our people array
        if(people[x].nino == nino){ // we're looking for a matching nino
            req.session.data['selectedPerson'] = people[x]; // if one is found, we copy all of the current object to our selected person session
        }
    }

    if(req.session.data['selectedPerson']!=null){ // this means we found someone in the loop above as the session isn't empty
        res.redirect("set-interest-confirm");
    }
    else{
        req.session.data['error'] = "true" // because we didn't find anyone we can trigger an error and redirect bck to the same page to show the error message on the page
        res.redirect("set-interest")
    }
})

router.post('/' + version + '/manage-interest/set-interest-confirm', function (req, res) {
    //let page;
    req.session.data['error'] = "false" // set the error to false in case it was triggered on the previous page
    
    if(req.session.data['confirmPerson']=="Yes"){ // if they confirm the person is correct
        
        // As we work through creating interest we keep two arrays active
        // data['activeInterests'] - this records objects where we've already set an interest
        // data['viewableInterests'] - this records objects where we've already set an interest but no outcome has been recorded - this is how we know what to show in the view interest page
        
        // this section checks to see if we have the nino already set as an interest
        if(req.session.data['activeInterests']){ // if the activeInterest array exists (it won't if this is your first time through)
            let tempArray = req.session.data['activeInterests'] // creata a temporary array and load all the object from the activeInterests array
            for (let x = 0; x < tempArray.length; x++) {  //loop through all the objects in the array
                if(tempArray[x].nino == req.session.data['nino']){ //check for any matching ninos
                    res.redirect("set-interest-view-earnings-confirm"); // if there is a match we skip the date entry screen
                    return; // this posts the page stopping any header errors
                }
            }
        }

        // if no match was found we simply redirect basd on the journey flow
        if(req.session.data['benefit']=="Housing Benefit"){
            res.redirect("set-interest-benefit-select");
        }
        else{
            res.redirect("set-interest-start-date")
        }

    } // if they select that the person isnt a match
    else if(req.session.data['confirmPerson']=="No"){
        res.redirect("set-interest")
    }
    else{ // if they don't make a selection then we trigger an on-page errror
        req.session.data['error'] = "true"
        res.redirect("set-interest-confirm")
    }

})

