//// SET AN INTEREST ////

router.post('/' + version + '/manage-interest/set-interest', function (req, res) {
   req.session.data['error'] = "false"
   let nino = req.session.data['nino'].toUpperCase().replace(/ /g,'')
   req.session.data['nino'] = nino
   let people = req.session.data['earnings']
   req.session.data['selectedPerson'] = null

   for (let x = 0; x < people.length; x++) { 
        if(people[x].nino == nino){
            req.session.data['selectedPerson'] = people[x];
        }
    }
    if(req.session.data['selectedPerson']!=null){
        res.redirect("set-interest-confirm");
    }
    else{
        req.session.data['error'] = "true"
        res.redirect("set-interest")
    }
})

router.post('/' + version + '/manage-interest/set-interest-confirm', function (req, res) {
    
    let page;
    req.session.data['error'] = "false"
    if(req.session.data['confirmPerson']=="Yes"){

        if(req.session.data['activeInterests']){
            let tempArray = req.session.data['activeInterests']
            for (let x = 0; x < tempArray.length; x++) {
                if(tempArray[x].nino == req.session.data['nino']){
                    req.session.data['interestStart'] = new Date(2024-12-01)
                    res.redirect("set-interest-view-earnings-confirm");
                    return;
                }
            }
        }

        if(req.session.data['benefit']=="Housing Benefit"){
            res.redirect("set-interest-benefit-select");
        }
        else{
            res.redirect("set-interest-start-date")
        }

    }
    else if(req.session.data['confirmPerson']=="No"){
        res.redirect("set-interest")
    }
    else{
        req.session.data['error'] = "true"
        res.redirect("set-interest-confirm")
    }

})
