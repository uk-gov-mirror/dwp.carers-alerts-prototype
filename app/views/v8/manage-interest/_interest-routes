// these function can be used over and over again in different parts of the routes file 
function removeFromAnInterestList(interestList, selectedPerson) {
    for(let x = 0; x < interestList.length; x++) { //loop through all the records in the array
        if(interestList[x].nino == selectedPerson.nino){ //we try to match each array record nino with the selected persons nino
            interestList.splice(x, 1); // if we find a match we remove the object from the array
        }
    }
    return(interestList); // we return back to where we called the funtion from
}


